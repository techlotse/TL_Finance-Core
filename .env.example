# ============================================================
# TL Finance Core - environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- App --------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=TL Finance Core

# Random 32-byte hex string. Generate with: openssl rand -hex 32
# Production containers refuse to start while this is left as change-me.
APP_SECRET=change-me

# --- Database (single-node) ------------------------------------
# The DB user / database are still named `budget` (legacy) — renaming
# would force migration of any existing volume. Both compose files and
# this URL must change together if you rename for a fresh deploy.
DATABASE_URL=postgresql://budget:budget@db:5432/budget?schema=public

# --- Database (multinode) --------------------------------------
# Password for the budget DB user. Replace before production use.
DB_PASSWORD=budget

# Password for the streaming-replication user created by init-primary.sh.
# Replace before production use.
REPLICATION_PASSWORD=replicator_password

# --- Redis (multinode) ----------------------------------------
# Replace before production use.
REDIS_PASSWORD=redis_password

# --- PgAdmin (multinode, optional) ----------------------------
PGADMIN_EMAIL=admin@localhost
PGADMIN_PASSWORD=changeme
PGADMIN_PORT=5050

# --- Exchange rates --------------------------------------------
EXCHANGE_RATE_PROVIDER=frankfurter
FRANKFURTER_BASE_URL=https://api.frankfurter.app

# --- CI / Docker Hub -------------------------------------------
DOCKER_IMAGE_NAME=your-dockerhub-username/tl-finance-core
