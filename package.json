{
  "name": "tl-finance-core",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:access": "vitest run --config vitest.access.config.ts",
    "test:readiness": "node scripts/public-readiness-check.mjs",
    "test:readiness:v0.8": "node scripts/v0.8-readiness-check.mjs",
    "test:migrations": "node scripts/check-migrations-additive.mjs",
    "audit:prod": "npm audit --omit=dev",
    "ci": "npm run prisma:generate && npm run typecheck && npm run lint && npm run test && npm run test:readiness && npm run test:readiness:v0.8 && npm run test:migrations && npm run audit:prod && npm run prisma:deploy && npm run test:access && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "@hono/node-server": "1.19.13"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.18",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
